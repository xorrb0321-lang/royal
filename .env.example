# Instagram credentials
IG_USERNAME=your_username
IG_PASSWORD=your_password

# Optional: TOTP secret for 2FA (without spaces)
IG_TOTP_SECRET=

# Session storage: file (default) or redis
SESSION_STORAGE=file
SESSION_FILE=sessions/session.json
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_KEY=ig:session:default

# Optional: stable residential proxy per account
# Format: scheme://username:password@host:port
# Use socks5h:// for SOCKS proxies so DNS resolves through the proxy
IG_PROXY=

# Optional: match device locale to account region
IG_COUNTRY=US
IG_LOCALE=en_US
IG_TIMEZONE_OFFSET=-14400
